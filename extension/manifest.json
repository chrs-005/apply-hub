{
  "manifest_version": 3,
  "name": "Apply Hub Autofill",
  "version": "1.0.0",
  "description": "One-click autofill for internship and grad-school applications (Workday, Greenhouse, Lever, Ashby, SmartRecruiters, university portals).",
  "icons": { "16": "icons/icon-16.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "options_page": "options.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "unlimitedStorage", "contextMenus", "activeTab", "clipboardWrite"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["fields.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "fill-form": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Autofill the application on this page"
    }
  }
}
